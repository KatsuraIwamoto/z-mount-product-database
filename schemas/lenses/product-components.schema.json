{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cercidiphyllum.jp/schemas/1.0.0/lenses/product-components.schema.json",
  "$comment": "SPDX-FileCopyrightText: 2026 Katsura Iwamoto\nSPDX-License-Identifier: MIT",
  "description": "Reusable identity, lifecycle, source, mount, physical, control, accessory, and electronic-service structures.",
  "$defs": {
    "identity": {
      "type": "object",
      "required": [
        "manufacturerId",
        "brandId",
        "productName",
        "modelNumberOptions",
        "alternateNames",
        "variants"
      ],
      "properties": {
        "manufacturerId": {
          "$ref": "../shared/shared-definitions.schema.json#/$defs/id"
        },
        "brandId": {
          "$ref": "../shared/shared-definitions.schema.json#/$defs/id"
        },
        "productName": {
          "$ref": "../shared/shared-definitions.schema.json#/$defs/nonEmptyString"
        },
        "modelNumberOptions": {
          "$ref": "../shared/shared-definitions.schema.json#/$defs/modelNumberOptions"
        },
        "alternateNames": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "$ref": "../shared/shared-definitions.schema.json#/$defs/nonEmptyString"
                  },
                  "brandId": {
                    "$ref": "../shared/shared-definitions.schema.json#/$defs/id"
                  },
                  "region": {
                    "$ref": "../shared/shared-definitions.schema.json#/$defs/region"
                  },
                  "language": {
                    "$ref": "../shared/shared-definitions.schema.json#/$defs/language"
                  }
                },
                "additionalProperties": false
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "variants": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "variantId",
                  "name",
                  "modelNumberOptions"
                ],
                "properties": {
                  "variantId": {
                    "$ref": "../shared/shared-definitions.schema.json#/$defs/id"
                  },
                  "name": {
                    "$ref": "../shared/shared-definitions.schema.json#/$defs/nonEmptyString"
                  },
                  "modelNumberOptions": {
                    "$ref": "../shared/shared-definitions.schema.json#/$defs/modelNumberOptions"
                  },
                  "color": {
                    "$ref": "../shared/shared-definitions.schema.json#/$defs/nonEmptyString"
                  },
                  "focusScaleUnit": {
                    "enum": [
                      "meters",
                      "feet"
                    ]
                  }
                },
                "additionalProperties": false
              }
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "lifecycle": {
      "type": "object",
      "required": [
        "announcementDate",
        "officialDesignations"
      ],
      "properties": {
        "announcementDate": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "officialDesignations": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "enum": [
                      "legacy-product",
                      "sales-ended",
                      "production-ended",
                      "discontinued"
                    ]
                  },
                  "region": {
                    "$ref": "../shared/shared-definitions.schema.json#/$defs/region"
                  },
                  "observedOn": {
                    "type": "string",
                    "format": "date"
                  }
                },
                "additionalProperties": false
              },
              "uniqueItems": true
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "officialProductPage": {
      "type": "object",
      "required": [
        "url",
        "pageFamilies",
        "region",
        "language",
        "publisher"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "pageFamilies": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "home-country",
              "global",
              "japan",
              "nikon-imaging-japan",
              "usa"
            ]
          },
          "uniqueItems": true
        },
        "region": {
          "oneOf": [
            {
              "$ref": "../shared/shared-definitions.schema.json#/$defs/region"
            },
            {
              "type": "null"
            }
          ]
        },
        "language": {
          "oneOf": [
            {
              "$ref": "../shared/shared-definitions.schema.json#/$defs/language"
            },
            {
              "type": "null"
            }
          ]
        },
        "publisher": {
          "type": "object",
          "required": [
            "type",
            "name"
          ],
          "properties": {
            "type": {
              "enum": [
                "manufacturer-or-brand",
                "authorized-distributor"
              ]
            },
            "name": {
              "$ref": "../shared/shared-definitions.schema.json#/$defs/nonEmptyString"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "officialMountAdapter": {
      "type": "object",
      "required": [
        "relationship",
        "dedicatedToProduct",
        "nativeMountSystemId",
        "name",
        "modelNumberOptions"
      ],
      "properties": {
        "relationship": {
          "enum": [
            "supplied",
            "optional"
          ]
        },
        "dedicatedToProduct": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "nativeMountSystemId": {
          "oneOf": [
            {
              "$ref": "../shared/shared-definitions.schema.json#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "oneOf": [
            {
              "$ref": "../shared/shared-definitions.schema.json#/$defs/nonEmptyString"
            },
            {
              "type": "null"
            }
          ]
        },
        "modelNumberOptions": {
          "oneOf": [
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "../shared/shared-definitions.schema.json#/$defs/nonEmptyString"
              },
              "uniqueItems": true
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "relationship": {
                "const": "optional"
              }
            },
            "required": [
              "relationship"
            ]
          },
          "then": {
            "properties": {
              "dedicatedToProduct": {
                "const": true
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "mount": {
      "type": "object",
      "required": [
        "systemId",
        "replaceability",
        "mountOwnerRelationship",
        "electronicContacts"
      ],
      "properties": {
        "systemId": {
          "const": "nikon-z"
        },
        "replaceability": {
          "enum": [
            "fixed",
            "user-interchangeable",
            "service-interchangeable",
            null
          ]
        },
        "mountOwnerRelationship": {
          "enum": [
            "mount-owner",
            "officially-licensed",
            null
          ]
        },
        "electronicContacts": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "present"
              ],
              "properties": {
                "present": {
                  "const": false
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "present",
                "metadataTransmission"
              ],
              "properties": {
                "present": {
                  "const": true
                },
                "metadataTransmission": {
                  "$ref": "../shared/shared-definitions.schema.json#/$defs/metadataTransmission"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "adapter": {
          "$ref": "#/$defs/officialMountAdapter"
        }
      },
      "additionalProperties": false
    },
    "dimensionMeasurement": {
      "type": "object",
      "required": [
        "maximumDiameterMm",
        "lengthMm",
        "conditions"
      ],
      "properties": {
        "maximumDiameterMm": {
          "oneOf": [
            {
              "$ref": "../shared/shared-definitions.schema.json#/$defs/positiveNumber"
            },
            {
              "type": "null"
            }
          ]
        },
        "lengthMm": {
          "oneOf": [
            {
              "$ref": "../shared/shared-definitions.schema.json#/$defs/positiveNumber"
            },
            {
              "type": "null"
            }
          ]
        },
        "approximate": {
          "type": "boolean"
        },
        "conditions": {
          "type": "object",
          "properties": {
            "state": {
              "enum": [
                "operational",
                "storage",
                "at-infinity"
              ]
            },
            "variantId": {
              "$ref": "../shared/shared-definitions.schema.json#/$defs/id"
            },
            "attachedComponents": {
              "type": "array",
              "items": {
                "$ref": "../shared/shared-definitions.schema.json#/$defs/measurementComponent"
              },
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        }
      },
      "anyOf": [
        {
          "properties": {
            "maximumDiameterMm": {
              "$ref": "../shared/shared-definitions.schema.json#/$defs/positiveNumber"
            }
          }
        },
        {
          "properties": {
            "lengthMm": {
              "$ref": "../shared/shared-definitions.schema.json#/$defs/positiveNumber"
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "weightMeasurement": {
      "type": "object",
      "required": [
        "grams",
        "conditions"
      ],
      "properties": {
        "grams": {
          "$ref": "../shared/shared-definitions.schema.json#/$defs/positiveNumber"
        },
        "approximate": {
          "type": "boolean"
        },
        "conditions": {
          "type": "object",
          "required": [
            "attachedComponents"
          ],
          "properties": {
            "attachedComponents": {
              "type": "array",
              "items": {
                "$ref": "../shared/shared-definitions.schema.json#/$defs/measurementComponent"
              },
              "uniqueItems": true
            },
            "variantId": {
              "$ref": "../shared/shared-definitions.schema.json#/$defs/id"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "filterInterface": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "diameterMm",
            "host"
          ],
          "properties": {
            "type": {
              "const": "front-thread"
            },
            "diameterMm": {
              "$ref": "../shared/shared-definitions.schema.json#/$defs/positiveNumber"
            },
            "host": {
              "$ref": "../shared/shared-definitions.schema.json#/$defs/host"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "diameterMm",
            "host"
          ],
          "properties": {
            "type": {
              "const": "rear-thread"
            },
            "diameterMm": {
              "$ref": "../shared/shared-definitions.schema.json#/$defs/positiveNumber"
            },
            "host": {
              "$ref": "../shared/shared-definitions.schema.json#/$defs/host"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "filterDiameterMm",
            "host"
          ],
          "properties": {
            "type": {
              "const": "drop-in"
            },
            "filterDiameterMm": {
              "$ref": "../shared/shared-definitions.schema.json#/$defs/positiveNumber"
            },
            "host": {
              "$ref": "../shared/shared-definitions.schema.json#/$defs/host"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "sheetDimensionsMm",
            "host"
          ],
          "properties": {
            "type": {
              "const": "rear-gelatin"
            },
            "sheetDimensionsMm": {
              "oneOf": [
                {
                  "type": "object",
                  "required": [
                    "width",
                    "height"
                  ],
                  "properties": {
                    "width": {
                      "$ref": "../shared/shared-definitions.schema.json#/$defs/positiveNumber"
                    },
                    "height": {
                      "$ref": "../shared/shared-definitions.schema.json#/$defs/positiveNumber"
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "host": {
              "$ref": "../shared/shared-definitions.schema.json#/$defs/host"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "physical": {
      "type": "object",
      "required": [
        "dimensionMeasurements",
        "weightMeasurements",
        "officialEnvironmentalProtectionClaims",
        "filterInterfaces",
        "tripodSupport"
      ],
      "properties": {
        "dimensionMeasurements": {
          "oneOf": [
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/dimensionMeasurement"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "weightMeasurements": {
          "oneOf": [
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/weightMeasurement"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "officialEnvironmentalProtectionClaims": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "$ref": "../shared/shared-definitions.schema.json#/$defs/environmentalClaim"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "filterInterfaces": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/filterInterface"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "tripodSupport": {
          "$ref": "../shared/shared-definitions.schema.json#/$defs/tripodSupport"
        },
        "externalLengthDuringZoom": {
          "enum": [
            "constant",
            "variable",
            null
          ]
        },
        "externalLengthDuringFocus": {
          "enum": [
            "constant",
            "variable",
            null
          ]
        },
        "isRetractableForStorage": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "frontAccessoryInterface": {
          "type": "object",
          "required": [
            "outsideDiameterMm"
          ],
          "properties": {
            "outsideDiameterMm": {
              "$ref": "../shared/shared-definitions.schema.json#/$defs/positiveNumber"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "control": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "quantity"
          ],
          "properties": {
            "type": {
              "enum": [
                "aperture-ring",
                "control-ring",
                "function-ring",
                "focus-ring",
                "zoom-ring"
              ]
            },
            "quantity": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "officialName": {
              "$ref": "../shared/shared-definitions.schema.json#/$defs/nonEmptyString"
            },
            "clickBehavior": {
              "enum": [
                "clicked",
                "declicked",
                "switchable"
              ]
            },
            "rotationDegrees": {
              "$ref": "../shared/shared-definitions.schema.json#/$defs/positiveNumber"
            },
            "geared": {
              "type": "boolean"
            },
            "response": {
              "enum": [
                "linear",
                "nonlinear",
                "switchable"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "quantity"
          ],
          "properties": {
            "type": {
              "enum": [
                "power-zoom-control",
                "zoom-lever",
                "function-button",
                "memory-set-button",
                "focus-mode-switch",
                "focus-limiter",
                "zoom-lock",
                "aperture-ring-click-switch",
                "control-ring-click-switch",
                "aperture-ring-lock",
                "information-display",
                "focus-distance-scale",
                "depth-of-field-scale",
                "other"
              ]
            },
            "quantity": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "officialName": {
              "$ref": "../shared/shared-definitions.schema.json#/$defs/nonEmptyString"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "accessoryRelationship": {
      "type": "object",
      "required": [
        "relationship",
        "modelNumberOptions",
        "quantity"
      ],
      "properties": {
        "relationship": {
          "enum": [
            "supplied",
            "optional",
            "integrated",
            null
          ]
        },
        "modelNumberOptions": {
          "$ref": "../shared/shared-definitions.schema.json#/$defs/modelNumberOptions"
        },
        "quantity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "caseAccessory": {
      "type": "object",
      "required": [
        "construction",
        "relationship",
        "modelNumberOptions",
        "quantity"
      ],
      "properties": {
        "construction": {
          "enum": [
            "soft-case",
            "hard-case"
          ]
        },
        "relationship": {
          "enum": [
            "supplied",
            "optional",
            null
          ]
        },
        "modelNumberOptions": {
          "$ref": "../shared/shared-definitions.schema.json#/$defs/modelNumberOptions"
        },
        "quantity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "accessories": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "lensHoods",
            "frontCaps",
            "rearCaps",
            "lensCases",
            "lensStraps",
            "protectiveWraps"
          ],
          "properties": {
            "lensHoods": {
              "oneOf": [
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/accessoryRelationship"
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "frontCaps": {
              "oneOf": [
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/accessoryRelationship"
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "rearCaps": {
              "oneOf": [
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/accessoryRelationship"
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "lensCases": {
              "oneOf": [
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/caseAccessory"
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "lensStraps": {
              "oneOf": [
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/accessoryRelationship"
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "protectiveWraps": {
              "oneOf": [
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/accessoryRelationship"
                  }
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "title": "Product components"
}
