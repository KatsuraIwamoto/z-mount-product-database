{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cercidiphyllum.jp/schemas/1.0.0/lenses/product-light.schema.json",
  "$comment": "SPDX-FileCopyrightText: 2026 Katsura Iwamoto\nSPDX-License-Identifier: MIT",
  "description": "A minimal display and plotting projection that preserves the full product structure and values.",
  "$defs": {
    "identity": {
      "type": "object",
      "required": [
        "manufacturerId",
        "brandId",
        "productName"
      ],
      "properties": {
        "manufacturerId": {
          "$ref": "../shared/shared-definitions.schema.json#/$defs/id"
        },
        "brandId": {
          "$ref": "../shared/shared-definitions.schema.json#/$defs/id"
        },
        "productName": {
          "$ref": "../shared/shared-definitions.schema.json#/$defs/nonEmptyString"
        }
      },
      "additionalProperties": false
    },
    "officialProductPage": {
      "type": "object",
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        }
      },
      "additionalProperties": false
    },
    "filterInterface": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "diameterMm"
          ],
          "properties": {
            "type": {
              "const": "front-thread"
            },
            "diameterMm": {
              "$ref": "../shared/shared-definitions.schema.json#/$defs/positiveNumber"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "diameterMm"
          ],
          "properties": {
            "type": {
              "const": "rear-thread"
            },
            "diameterMm": {
              "$ref": "../shared/shared-definitions.schema.json#/$defs/positiveNumber"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "filterDiameterMm"
          ],
          "properties": {
            "type": {
              "const": "drop-in"
            },
            "filterDiameterMm": {
              "$ref": "../shared/shared-definitions.schema.json#/$defs/positiveNumber"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "sheetDimensionsMm"
          ],
          "properties": {
            "type": {
              "const": "rear-gelatin"
            },
            "sheetDimensionsMm": {
              "oneOf": [
                {
                  "type": "object",
                  "required": [
                    "width",
                    "height"
                  ],
                  "properties": {
                    "width": {
                      "$ref": "../shared/shared-definitions.schema.json#/$defs/positiveNumber"
                    },
                    "height": {
                      "$ref": "../shared/shared-definitions.schema.json#/$defs/positiveNumber"
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "physical": {
      "type": "object",
      "required": [
        "dimensionMeasurements",
        "weightMeasurements",
        "filterInterfaces"
      ],
      "properties": {
        "dimensionMeasurements": {
          "oneOf": [
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "product-components.schema.json#/$defs/dimensionMeasurement"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "weightMeasurements": {
          "oneOf": [
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "product-components.schema.json#/$defs/weightMeasurement"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "filterInterfaces": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/filterInterface"
              }
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "fNumberApertureValues": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "maximumAperture"
          ],
          "properties": {
            "maximumAperture": {
              "oneOf": [
                {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "../shared/shared-definitions.schema.json#/$defs/fNumberMeasurement"
                  }
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "tNumberApertureValues": {
      "type": "object",
      "required": [
        "maximumAperture"
      ],
      "properties": {
        "maximumAperture": {
          "oneOf": [
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "../shared/shared-definitions.schema.json#/$defs/tNumberMeasurement"
              }
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "aperture": {
      "type": "object",
      "required": [
        "fNumber"
      ],
      "properties": {
        "fNumber": {
          "$ref": "#/$defs/fNumberApertureValues"
        },
        "tNumber": {
          "$ref": "#/$defs/tNumberApertureValues"
        }
      },
      "additionalProperties": false
    },
    "presence": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "present"
          ],
          "properties": {
            "present": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "focus": {
      "type": "object",
      "required": [
        "autofocus",
        "manualFocus",
        "minimumFocusDistances",
        "reproductionMagnifications"
      ],
      "properties": {
        "autofocus": {
          "$ref": "#/$defs/presence"
        },
        "manualFocus": {
          "$ref": "#/$defs/presence"
        },
        "minimumFocusDistances": {
          "description": "Exact full-dataset entries whose distanceM equals the shortest published value; all ties are retained in source order.",
          "oneOf": [
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "../shared/shared-definitions.schema.json#/$defs/minimumFocusDistance"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "reproductionMagnifications": {
          "description": "Exact full-dataset entries whose published upper value (value, maximum, or the greatest discrete value) equals the product's greatest reproduction magnification; all ties are retained in source order.",
          "oneOf": [
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "../shared/shared-definitions.schema.json#/$defs/reproductionMagnification"
              }
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "specializedMarker": {
      "type": "object",
      "maxProperties": 0,
      "additionalProperties": false
    },
    "specialized": {
      "type": "object",
      "properties": {
        "cinema": {
          "$ref": "#/$defs/specializedMarker"
        },
        "anamorphic": {
          "$ref": "#/$defs/specializedMarker"
        },
        "fisheye": {
          "$ref": "#/$defs/specializedMarker"
        },
        "macro": {
          "$ref": "#/$defs/specializedMarker"
        },
        "reflex": {
          "$ref": "#/$defs/specializedMarker"
        },
        "movements": {
          "$ref": "#/$defs/specializedMarker"
        },
        "probe": {
          "$ref": "#/$defs/specializedMarker"
        },
        "builtInTeleconverter": {
          "$ref": "#/$defs/specializedMarker"
        }
      },
      "additionalProperties": false
    },
    "lens": {
      "type": "object",
      "required": [
        "focalLength",
        "aperture",
        "coverage",
        "focus",
        "stabilization",
        "specialized"
      ],
      "properties": {
        "focalLength": {
          "oneOf": [
            {
              "$ref": "../shared/shared-definitions.schema.json#/$defs/focalLength"
            },
            {
              "type": "null"
            }
          ]
        },
        "aperture": {
          "$ref": "#/$defs/aperture"
        },
        "coverage": {
          "$ref": "../shared/shared-definitions.schema.json#/$defs/coverage"
        },
        "focus": {
          "$ref": "#/$defs/focus"
        },
        "stabilization": {
          "$ref": "#/$defs/presence"
        },
        "specialized": {
          "$ref": "#/$defs/specialized"
        }
      },
      "additionalProperties": false
    },
    "teleconverter": {
      "type": "object",
      "required": [
        "coverage",
        "magnification",
        "apertureLossStops",
        "supportsAutofocus",
        "compatibleLensIds"
      ],
      "properties": {
        "coverage": {
          "$ref": "../shared/shared-definitions.schema.json#/$defs/coverage"
        },
        "magnification": {
          "$ref": "../shared/shared-definitions.schema.json#/$defs/positiveNumber"
        },
        "apertureLossStops": {
          "$ref": "../shared/shared-definitions.schema.json#/$defs/nonNegativeNumber"
        },
        "supportsAutofocus": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "compatibleLensIds": {
          "oneOf": [
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "../shared/shared-definitions.schema.json#/$defs/id"
              },
              "uniqueItems": true
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "pinhole": {
      "type": "object",
      "required": [
        "coverage",
        "focalLength",
        "imagingModes"
      ],
      "properties": {
        "coverage": {
          "$ref": "../shared/shared-definitions.schema.json#/$defs/coverage"
        },
        "focalLength": {
          "$ref": "product-type-pinhole.schema.json#/$defs/focalLength"
        },
        "imagingModes": {
          "$ref": "product-type-pinhole.schema.json#/properties/imagingModes"
        }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": [
    "id",
    "productType",
    "identity",
    "lifecycle",
    "officialProductPages",
    "mount",
    "physical"
  ],
  "properties": {
    "id": {
      "$ref": "../shared/shared-definitions.schema.json#/$defs/id",
      "description": "Slug-form product ID copied from Full in the shared lenses namespace. Its text is not a source of product attributes."
    },
    "productType": {
      "enum": [
        "lens",
        "teleconverter",
        "pinhole"
      ]
    },
    "identity": {
      "$ref": "#/$defs/identity"
    },
    "lifecycle": {
      "$ref": "product-components.schema.json#/$defs/lifecycle"
    },
    "officialProductPages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/officialProductPage"
      }
    },
    "mount": {
      "$ref": "product-components.schema.json#/$defs/mount"
    },
    "physical": {
      "$ref": "#/$defs/physical"
    },
    "lens": {
      "$ref": "#/$defs/lens"
    },
    "teleconverter": {
      "$ref": "#/$defs/teleconverter"
    },
    "pinhole": {
      "$ref": "#/$defs/pinhole"
    }
  },
  "oneOf": [
    {
      "properties": {
        "productType": {
          "const": "lens"
        }
      },
      "required": [
        "lens"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "teleconverter"
            ]
          },
          {
            "required": [
              "pinhole"
            ]
          }
        ]
      }
    },
    {
      "properties": {
        "productType": {
          "const": "teleconverter"
        }
      },
      "required": [
        "teleconverter"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "lens"
            ]
          },
          {
            "required": [
              "pinhole"
            ]
          }
        ]
      }
    },
    {
      "properties": {
        "productType": {
          "const": "pinhole"
        }
      },
      "required": [
        "pinhole"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "lens"
            ]
          },
          {
            "required": [
              "teleconverter"
            ]
          }
        ]
      }
    }
  ],
  "additionalProperties": false,
  "title": "Light product"
}
