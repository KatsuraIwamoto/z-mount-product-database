{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cercidiphyllum.jp/schemas/1.0.0/lenses/dataset-light.schema.json",
  "$comment": "SPDX-FileCopyrightText: 2026 Katsura Iwamoto\nSPDX-License-Identifier: MIT",
  "type": "object",
  "required": [
    "$schema",
    "datasetName",
    "datasetVariant",
    "schemaVersion",
    "dataVersion",
    "creator",
    "license",
    "licenseUrl",
    "repositoryUrl",
    "recordCount",
    "contentHash",
    "referenceData",
    "products"
  ],
  "properties": {
    "$schema": {
      "const": "https://cercidiphyllum.jp/schemas/1.0.0/lenses/dataset-light.schema.json"
    },
    "datasetName": {
      "const": "Z Mount Lens Database"
    },
    "datasetVariant": {
      "const": "light"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "dataVersion": {
      "description": "Data release identifier and release date in YYYY.MM.DD format.",
      "type": "string",
      "pattern": "^\\d{4}\\.(?:0[1-9]|1[0-2])\\.(?:0[1-9]|[12]\\d|3[01])$"
    },
    "creator": {
      "type": "string"
    },
    "license": {
      "description": "License applied to the dataset contents, not to this schema file.",
      "const": "CC-BY-4.0"
    },
    "licenseUrl": {
      "description": "URL of the license applied to the dataset contents.",
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "repositoryUrl": {
      "description": "Canonical public repository containing the source records, schemas, issue tracker, and release history for this dataset.",
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "recordCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "contentHash": {
      "description": "SHA-256 of an object containing referenceData and products, canonicalized with RFC 8785 and encoded as UTF-8, with array order preserved. Numbers in the payload must satisfy the I-JSON requirements used by RFC 8785.",
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "referenceData": {
      "$ref": "../shared/reference-data.schema.json"
    },
    "products": {
      "type": "array",
      "items": {
        "$ref": "product-light.schema.json"
      }
    }
  },
  "additionalProperties": false,
  "title": "Light lens dataset"
}
