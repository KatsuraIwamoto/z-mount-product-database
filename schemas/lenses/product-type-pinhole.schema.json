{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cercidiphyllum.jp/schemas/1.0.0/lenses/product-type-pinhole.schema.json",
  "$comment": "SPDX-FileCopyrightText: 2026 Katsura Iwamoto\nSPDX-License-Identifier: MIT",
  "description": "Specifications for a directly mountable pinhole, sieve, or zone-plate product.",
  "$defs": {
    "focalLength": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "millimeters"
          ],
          "properties": {
            "kind": {
              "const": "fixed"
            },
            "millimeters": {
              "$ref": "../shared/shared-definitions.schema.json#/$defs/positiveNumber"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "rangeMm"
          ],
          "properties": {
            "kind": {
              "const": "variable"
            },
            "rangeMm": {
              "type": "object",
              "required": [
                "minimum",
                "maximum"
              ],
              "properties": {
                "minimum": {
                  "$ref": "../shared/shared-definitions.schema.json#/$defs/positiveNumber"
                },
                "maximum": {
                  "$ref": "../shared/shared-definitions.schema.json#/$defs/positiveNumber"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "opening": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "diameterMm"
          ],
          "properties": {
            "kind": {
              "const": "fixed"
            },
            "diameterMm": {
              "$ref": "../shared/shared-definitions.schema.json#/$defs/positiveNumber"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "diametersMm"
          ],
          "properties": {
            "kind": {
              "const": "discrete"
            },
            "diametersMm": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "../shared/shared-definitions.schema.json#/$defs/positiveNumber"
              },
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "minimumDiameterMm",
            "maximumDiameterMm"
          ],
          "properties": {
            "kind": {
              "const": "continuous-range"
            },
            "minimumDiameterMm": {
              "$ref": "../shared/shared-definitions.schema.json#/$defs/positiveNumber"
            },
            "maximumDiameterMm": {
              "$ref": "../shared/shared-definitions.schema.json#/$defs/positiveNumber"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "type": "object",
  "required": [
    "coverage",
    "focalLength",
    "imagingModes",
    "anglesOfView"
  ],
  "properties": {
    "coverage": {
      "$ref": "../shared/shared-definitions.schema.json#/$defs/coverage"
    },
    "focalLength": {
      "$ref": "#/$defs/focalLength"
    },
    "imagingModes": {
      "oneOf": [
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "type",
              "fNumber",
              "opening"
            ],
            "properties": {
              "type": {
                "enum": [
                  "pinhole",
                  "pinhole-sieve",
                  "zone-plate"
                ]
              },
              "fNumber": {
                "oneOf": [
                  {
                    "$ref": "../shared/shared-definitions.schema.json#/$defs/positiveNumber"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "opening": {
                "$ref": "#/$defs/opening"
              }
            },
            "additionalProperties": false
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "anglesOfView": {
      "oneOf": [
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "../shared/shared-definitions.schema.json#/$defs/angleOfView"
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "title": "Pinhole product fields"
}
